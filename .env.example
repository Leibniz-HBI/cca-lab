# A profile can reference this variable by name: LLM_API_KEY
LLM_API_KEY=
CCA_LAB_MAX_UPLOAD_BYTES=1073741824

# Maximum number of rows in a registered gold dataset
CCA_LAB_MAX_EVAL_ROWS=50000

# Application diagnostics: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
CCA_LAB_LOG_LEVEL=INFO

# Generate SECRET with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET=
# Initial site administrator; required on first startup. Change via UI afterwards.
CCA_LAB_ADMIN_USERNAME=admin
CCA_LAB_ADMIN_PASSWORD=
CCA_LAB_ALLOW_REGISTRATION=true
# Set true when serving over HTTPS (required for remote deployment).
CCA_LAB_COOKIE_SECURE=false

# Only these environment variables may be used for LLM API keys (never SECRET).
CCA_LAB_ALLOWED_API_KEY_ENVS=LLM_API_KEY
